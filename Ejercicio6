 public ArrayList<Factura> obtenerFacturaJuan() {
            ArrayList<Factura> clienteJuan = new ArrayList<>();
            for (Factura factura : listaFacturas) {
                if (factura.getCliente().getNombre().equalsIgnoreCase("Juan")) {
                    for (Producto producto : factura.getProductos()) {
                        if (producto.getCodigo().equals("123456")) {
                            clienteJuan.add(factura);
                        }
                    }
                }
            }
            return clienteJuan;
        }
